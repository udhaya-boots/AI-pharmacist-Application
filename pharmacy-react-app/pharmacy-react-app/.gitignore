# Ignore a specific file
config.js

# Ignore all files with a specific extension
*.log

# Ignore a specific folder
node_modules/

# Ignore all files in a folder
build/*

# Ignore files in any directory with that name
**/temp/

# Ignore a file only in the root directory
/README.txt


